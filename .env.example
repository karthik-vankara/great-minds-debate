# Copy this file to .env and fill in your values

# OpenAI API key — required
OPENAI_API_KEY=sk-your-api-key-here

# Model used for agent debate nodes and synthesis
# Recommended: gpt-4.1 | gpt-4o | gpt-4-turbo
DEBATE_MODEL=gpt-4.1

# Model used for the router (classifies which agents to pick)
# Recommended: gpt-4o-mini (cheap, fast — no creativity needed here)
ROUTER_MODEL=gpt-4o-mini
